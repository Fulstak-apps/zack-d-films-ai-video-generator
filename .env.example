# Only Wan animation requires a paid provider token.
REPLICATE_API_TOKEN=
WAN_CLIP_COST_USD=0.05
WAN_NUM_FRAMES=81

# Local script generation (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional Piper local TTS model file. macOS uses built-in 'say' by default.
PIPER_VOICE_MODEL=
